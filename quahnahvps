#!/usr/bin/env bash
set -e
[ -t 0 ] || { [ -e /dev/tty ] && exec </dev/tty; }
command -v openssl >/dev/null 2>&1 || { echo "Cần cài openssl: apt install openssl (hoặc yum/dnf/apk)"; exit 1; }
__P='q0NR6vYQU2CtXSHRhUrCgurBQkbushi4'
__TMP=$(mktemp)
trap 'rm -f "$__TMP"' EXIT
__B64=''
echo "$__B64" | base64 -d | openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass pass:"$__P" -out "$__TMP" 2>/dev/null \
  || { echo "Giải mã thất bại."; exit 1; }
bash "$__TMP" "$@"
